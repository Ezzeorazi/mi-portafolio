# ─── EmailJS (formulario de contacto, client-side) ───────────────────────────
# Expuestas al browser: deben ir con prefijo NEXT_PUBLIC_.
NEXT_PUBLIC_EMAILJS_SERVICE_ID=your_service_id
NEXT_PUBLIC_EMAILJS_TEMPLATE_ID=your_template_id
NEXT_PUBLIC_EMAILJS_PUBLIC_KEY=your_public_key

# ─── PageSpeed (herramienta de auditoría SEO) ────────────────────────────────
# Opcional. Sin key, la API de PageSpeed funciona con límites más bajos.
PAGESPEED_API_KEY=

# ─── Detector de granjas de contenido (/detector-de-bots) ────────────────────
# Base de datos Neon (Postgres). NO se exponen al browser (sin NEXT_PUBLIC_).
#  - DATABASE_URL: conexión pooled (…-pooler.…neon.tech) que usan las funciones
#    serverless de Next en Netlify.
#  - DIRECT_URL: conexión directa (sin -pooler) que usa Prisma Migrate.
# El worker Python usa DATABASE_URL con psycopg.
DATABASE_URL="postgresql://user:password@ep-xxx-pooler.region.aws.neon.tech/dbname?sslmode=require"
DIRECT_URL="postgresql://user:password@ep-xxx.region.aws.neon.tech/dbname?sslmode=require"

# GitHub: token para disparar el worker (repository_dispatch) al encolar un job, así se
# procesa al instante en vez de esperar al cron de respaldo. Fine-grained PAT con permiso
# "Contents: Read and write" sobre el repo. Solo hace falta en el hosting (Netlify), no en
# GitHub Actions. Si falta, el cron de respaldo procesa los jobs igual.
GITHUB_DISPATCH_TOKEN=

# Resend: envío del informe por email desde el worker. Free tier 3.000/mes.
RESEND_API_KEY=
# Remitente. Hasta verificar el dominio en Resend solo funciona onboarding@resend.dev
# (y solo se puede enviar al email dueño de la cuenta). Verificado el dominio:
# RESEND_FROM="Detector <detector@ezequiel-orazi.online>"
RESEND_FROM=
